{
  "Privacy": {
    "TR": "🕵️ Gizlilik & Anti-Telemetri",
    "EN": "🕵️ Privacy & Anti-Telemetry",
    "Items": [
      { "Name": "Windows Telemetrisini (Veri Toplama) Kapat", "Script": "Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection' -Name 'AllowTelemetry' -Value 0 -Type DWord -Force" },
      { "Name": "Konum İzlemeyi Kapat", "Script": "Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\location' -Name 'Value' -Value 'Deny' -Force" },
      { "Name": "Reklam Kimliğini (Ad ID) Devre Dışı Bırak", "Script": "Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo' -Name 'Enabled' -Value 0 -Type DWord -Force" },
      { "Name": "Uygulama Teşhis Verilerini Kapat", "Script": "Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\DataCollection' -Name 'LimitEnhancedDiagnosticDataWindowsInsider' -Value 0 -Type DWord -Force" },
      { "Name": "Geri Bildirim İstemlerini Kapat", "Script": "Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Siuf\\Rules' -Name 'NumberOfSIUFInPeriod' -Value 0 -Type DWord -Force" },
      { "Name": "Aktivite Geçmişini Kapat", "Script": "Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System' -Name 'EnableActivityFeed' -Value 0 -Type DWord -Force" },
      { "Name": "Kişiselleştirilmiş Deneyimleri Kapat", "Script": "Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Privacy' -Name 'TailoredExperiencesWithDiagnosticDataEnabled' -Value 0 -Type DWord -Force" }
    ]
  },
  "Performance": {
    "TR": "⚡ Performans & Hız Optimizasyonu",
    "EN": "⚡ Performance & Speed Optimization",
    "Items": [
      { "Name": "Gereksiz Arka Plan Uygulamalarını Engelle", "Script": "Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\BackgroundAccessApplications' -Name 'GlobalUserDisabled' -Value 1 -Type DWord -Force" },
      { "Name": "Nihai Performans (Ultimate Performance) Güç Planını Ekle", "Script": "powercfg -duplicatescheme e9a42b02-d5df-448d-aa00-03f14749eb61 | Out-Null" },
      { "Name": "Game DVR ve Xbox Game Bar'ı Kapat (FPS Artışı)", "Script": "Set-ItemProperty -Path 'HKCU:\\System\\GameConfigStore' -Name 'GameDVR_Enabled' -Value 0 -Type DWord -Force; Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR' -Name 'AllowGameDVR' -Value 0 -Type DWord -Force" },
      { "Name": "Ağ Darboğazını (Network Throttling) Kapat", "Script": "Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile' -Name 'NetworkThrottlingIndex' -Value 4294967295 -Type DWord -Force" },
      { "Name": "Sistem Yanıt Süresini Oyunlar İçin Optimize Et", "Script": "Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile' -Name 'SystemResponsiveness' -Value 0 -Type DWord -Force" },
      { "Name": "Hızlı Başlatmayı (Fast Startup) Kapat (SSD Ömrü İçin)", "Script": "Set-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power' -Name 'HiberbootEnabled' -Value 0 -Type DWord -Force" },
      { "Name": "Hibernation'ı (Uyku Modu) Kapat (C: Diskinde Yer Açar)", "Script": "powercfg.exe /hibernate off" },
      { "Name": "Görsel Animasyonları Performans İçin Kapat", "Script": "Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects' -Name 'VisualFXSetting' -Value 2 -Type DWord -Force" }
    ]
  },
  "UI": {
    "TR": "🎨 Arayüz & Windows Düzeni",
    "EN": "🎨 UI & Windows Layout",
    "Items": [
      { "Name": "Eski (Windows 10) Sağ Tık Menüsüne Dön", "Script": "New-Item -Path 'HKCU:\\Software\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\\InprocServer32' -Value '' -Force | Out-Null" },
      { "Name": "Karanlık Temayı (Dark Mode) Zorla", "Script": "Set-ItemProperty -Path 'HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' -Name 'AppsUseLightTheme' -Value 0 -Force; Set-ItemProperty -Path 'HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' -Name 'SystemUsesLightTheme' -Value 0 -Force" },
      { "Name": "Gizli Dosyaları ve Klasörleri Göster", "Script": "Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced' -Name 'Hidden' -Value 1 -Force" },
      { "Name": "Dosya Uzantılarını (.exe, .zip vb.) Göster", "Script": "Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced' -Name 'HideFileExt' -Value 0 -Force" },
      { "Name": "Başlat Menüsündeki Bing Arama Sonuçlarını Kapat", "Script": "Set-ItemProperty -Path 'HKCU:\\Software\\Policies\\Microsoft\\Windows\\Explorer' -Name 'DisableSearchBoxSuggestions' -Value 1 -Type DWord -Force" },
      { "Name": "Görev Çubuğundaki 'Widget'ları (Hava Durumu) Kaldır", "Script": "Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced' -Name 'TaskbarDa' -Value 0 -Force" },
      { "Name": "Görev Çubuğundaki Sohbet (Chat/Meet) İkonunu Kaldır", "Script": "Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced' -Name 'TaskbarMn' -Value 0 -Force" },
      { "Name": "Masaüstündeki Kısayol Oklarını Kaldır", "Script": "New-Item -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Shell Icons' -Force | Out-Null; Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Shell Icons' -Name '29' -Value '' -Force" }
    ]
  },
  "Advanced": {
    "TR": "⚠️ İleri Düzey Ayarlar & Kısıtlamalar",
    "EN": "⚠️ Advanced Tweaks & Restrictions",
    "Items": [
      { "Name": "Windows Otomatik Güncellemeleri Devre Dışı Bırak", "Script": "Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' -Name 'NoAutoUpdate' -Value 1 -Type DWord -Force" },
      { "Name": "Sürücülerin (Driver) Otomatik Güncellenmesini Engelle", "Script": "Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate' -Name 'ExcludeWUDriversInQualityUpdate' -Value 1 -Type DWord -Force" },
      { "Name": "Windows Defender'ı Kapat (ÖNERİLMEZ!)", "Script": "Set-MpPreference -DisableRealtimeMonitoring $true -ErrorAction SilentlyContinue" },
      { "Name": "IPv6'yı Devre Dışı Bırak", "Script": "Set-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Services\\Tcpip6\\Parameters' -Name 'DisabledComponents' -Value 255 -Type DWord -Force" },
      { "Name": "Teredo'yu Kapat (P2P/Xbox Ağını Keser)", "Script": "netsh interface teredo set state disabled | Out-Null" },
      { "Name": "Fare İvmesini (Mouse Acceleration) Kapat", "Script": "Set-ItemProperty -Path 'HKCU:\\Control Panel\\Mouse' -Name 'MouseSpeed' -Value 0 -Force" }
    ]
  }
}